@@ -2751,6 +2751,16 @@
   config.service_type = APST_auto; // this may be changed by the settings...
 
   // get a device id -- the first non-local MAC address
+#ifdef __ANDROID__
+  // Android 11+ hides MAC addresses from apps, so the caller passes a stable ID
+  // as 12 hex digits in SPS_HW_ADDR instead of waiting 10 s for one that never comes.
+  const char *hw = getenv("SPS_HW_ADDR");
+  unsigned int hb[6];
+  if (hw != NULL && sscanf(hw, "%2x%2x%2x%2x%2x%2x", &hb[0], &hb[1], &hb[2], &hb[3], &hb[4], &hb[5]) == 6) {
+    for (int i = 0; i < 6; i++)
+      ((uint8_t *)&config.hw_addr)[i] = (uint8_t)hb[i];
+  } else
+#endif
   get_device_id((uint8_t *)&config.hw_addr, 6);
 
   // get the endianness
