<?xml version="1.0" encoding="utf-8"?>
<!-- Companion app for the AirPlay 2 Speaker plugin: publishes the AirPlay track as an Android
     media session, because Kiosk Satellite's Local Media Session ignores sessions from its own
     process (where plugins run). The plugin bundles, installs and starts this app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.kieranwaugh.airplay2.nowplaying">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="AirPlay Now Playing"
        android:icon="@android:drawable/ic_media_play"
        android:allowBackup="false">

        <!-- Exported so the plugin (inside Kiosk Satellite) can start it. It only listens on
             127.0.0.1, so starting it is harmless. -->
        <service
            android:name=".NowPlayingService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Makes the app visible to Kiosk Satellite under Android 11+ package visibility
             (Kiosk queries for media browsers), so the plugin can start it. Nothing to browse. -->
        <service
            android:name=".BrowseService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
